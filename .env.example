# AdMitra — Environment Variables Template
# =========================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in real values in .env
# 3. NEVER commit .env to GitHub — it is in .gitignore
# =========================================

# --- Google Gemini LLM ---
# Get your free API key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# --- LLM Model Selection ---
LLM_MODEL=gemini-1.5-flash

# --- ChromaDB Persistent Storage ---
# Path where ChromaDB stores its vector index on disk
CHROMA_PERSIST_DIR=./ir/chroma_db

# --- Fernet Encryption Key ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-fernet-key-base64-here

# --- Rate Limiting ---
# Max calls per minute for EngagementAgent
ENGAGEMENT_RATE_LIMIT=10
